[Unit]
Description=KasQ Backend (Go API + Bot WA/Telegram)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/wwwroot/kasq.dianrp.com/kasQ/backend
EnvironmentFile=/www/wwwroot/kasQ/kasq.dianrp.com/kasQ/backend/.env
ExecStart=/www/wwwroot/kasQ/kasq.dianrp.com/kasQ/backend/kasq-server
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

# Log ke journalctl: journalctl -u kasq-backend -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
