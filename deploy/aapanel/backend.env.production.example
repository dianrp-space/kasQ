# Salin ke backend/.env di server production
# Ganti example.com, password, dan secret key

DATABASE_URL=postgres://kasq:STRONG_DB_PASSWORD@127.0.0.1:5432/kasq?sslmode=disable

# MinIO / S3-compatible (bisa MinIO terpisah atau layanan S3)
MINIO_ENDPOINT=https://s3.example.com
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_BUCKET=kasq
MINIO_USE_SSL=true

JWT_SECRET=GANTI_DENGAN_STRING_RANDOM_PANJANG_MIN_32_KARAKTER
APP_URL=https://kasq.example.com
API_URL=https://kasq.example.com
PORT=8084

SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=password-smtp
SMTP_FROM="KasQ <noreply@example.com>"
