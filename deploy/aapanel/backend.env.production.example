# Salin ke backend/.env di server production
# Ganti example.com, password, dan secret key

DATABASE_URL=postgres://kasq:STRONG_DB_PASSWORD@127.0.0.1:5432/kasq?sslmode=disable

# MinIO / S3-compatible (bisa MinIO terpisah atau layanan S3)
# MINIO_ENDPOINT: alamat yang dipakai backend untuk upload/read (boleh internal)
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_BUCKET=kasq
MINIO_USE_SSL=false
# MINIO_PUBLIC_ENDPOINT: host publik untuk link preview/download nota di browser
MINIO_PUBLIC_ENDPOINT=https://s3.example.com

JWT_SECRET=GANTI_DENGAN_STRING_RANDOM_PANJANG_MIN_32_KARAKTER
APP_URL=https://kasq.example.com
API_URL=https://kasq.example.com
PORT=8084

# Import nota — baca file lokal jika URL host sama VPS (hindari hairpin NAT)
# Format: host1:/path/docroot1,host2:/path/docroot2
IMPORT_NOTA_LOCAL_ROOTS=bon.dianrp.com:/www/wwwroot/bon.dianrp.com

SMTP_HOST=127.0.0.1
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=password-smtp
SMTP_FROM="KasQ <noreply@example.com>"
# Nama di sertifikat TLS mail server (mis. mail.example.com), jika SMTP_HOST=127.0.0.1
# SMTP_TLS_SERVER_NAME=mail.example.com
