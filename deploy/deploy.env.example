# Salin ke deploy/deploy.env lalu isi (file deploy.env di-gitignore)
#
# cp deploy/deploy.env.example deploy/deploy.env
#
# Atau deploy otomatis via GitHub Actions — lihat bagian di bawah.

# SSH ke VPS aaPanel
DEPLOY_HOST=your-server.com
DEPLOY_USER=root
DEPLOY_PORT=22
# DEPLOY_SSH_KEY=/home/dianrp/.ssh/kasq_deploy
# Agar tidak diminta password: ssh-copy-id -p PORT user@host

# Path root app di server (sesuai systemd & nginx)
DEPLOY_PATH=/www/wwwroot/kasq.example.com

# URL publik (HTTPS) — wajib untuk SvelteKit/PM2 ORIGIN
DEPLOY_PUBLIC_URL=https://kasq.example.com

# User proses backend systemd (aaPanel biasanya www)
DEPLOY_RUN_USER=www

# Frontend: pm2 (disarankan, pakai NVM user yang sudah ada) | systemd
DEPLOY_FRONTEND=pm2
DEPLOY_PM2_USER=dianrp
DEPLOY_PM2_APP_NAME=kasq-fe
# Opsional — path pm2 NVM (hindari deteksi otomatis gagal saat deploy dari root)
# DEPLOY_PM2_BIN=/home/dianrp/.nvm/versions/node/v24.19.0/bin/pm2

# Restart service setelah upload (false = upload saja)
DEPLOY_RESTART=true

# Target build backend (linux amd64 untuk VPS)
DEPLOY_GOOS=linux
DEPLOY_GOARCH=amd64

# Upload: hapus source map (*.map) sebelum rsync — lebih kecil & cepat
DEPLOY_STRIP_SOURCEMAPS=true
# Kompresi rsync (-z). false jika koneksi LAN/kencang
DEPLOY_RSYNC_COMPRESS=true

# npm ci setiap deploy lambat — default auto (skip jika package-lock.json tidak berubah)
# DEPLOY_SKIP_NPM_CI=auto | true (selalu skip) | false (selalu npm ci)
DEPLOY_SKIP_NPM_CI=auto
# Build backend + frontend bersamaan
DEPLOY_PARALLEL_BUILD=true
# Deploy parsial: all | backend | frontend (atau: make deploy-backend)
# DEPLOY_ONLY=all

# --- GitHub Actions (Settings → Secrets and variables → Actions) ---
#
# Secret 1: DEPLOY_ENV  (nama valid — tanpa titik)
#   Salin isi deploy/deploy.env lokal (sama persis, termasuk DEPLOY_PM2_BIN).
#   Path DEPLOY_SSH_KEY di file akan diganti otomatis oleh workflow CI.
#
# Secret 2: DEPLOY_SSH_KEY
#   Isi private key OpenSSH dari ~/.ssh/kasq_deploy (multiline), bukan path file.
#
# Contoh isi DEPLOY_ENV:
#   DEPLOY_HOST=kasq.dianrp.com
#   DEPLOY_USER=root
#   DEPLOY_PATH=/www/wwwroot/kasq.dianrp.com
#   DEPLOY_PUBLIC_URL=https://kasq.dianrp.com
#   DEPLOY_PM2_USER=dianrp
#   DEPLOY_PM2_BIN=/home/dianrp/.nvm/versions/node/v24.19.0/bin/pm2
#   DEPLOY_SSH_KEY=/path/lokal/ignored-by-ci
