DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/kasq?sslmode=disable
MINIO_ENDPOINT=https://s3.example.com
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=kasq
MINIO_USE_SSL=false
# Opsional: host publik untuk presigned URL preview/download nota (jika MINIO_ENDPOINT internal)
# MINIO_PUBLIC_ENDPOINT=https://s3.example.com
JWT_SECRET=dev-jwt-secret-change-in-production
APP_URL=http://localhost:3008
API_URL=http://localhost:8084
PORT=8084

# SMTP (wajib untuk register & forgot password)
SMTP_HOST=127.0.0.1
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="KasQ <noreply@kasq.local>"
# Nama host di sertifikat TLS mail server (jika SMTP_HOST bukan hostname sertifikat)
# SMTP_TLS_SERVER_NAME=mail.example.com
# Telegram bot sistem (opsional) — user awam bisa pakai tanpa buat bot sendiri
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF_from_BotFather
